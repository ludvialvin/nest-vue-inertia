NODE_ENV=development
PORT=3000

# Percayai X-Forwarded-For/Traffic reverse proxy (untuk rate limit IP asli).
# false / true / jumlah hop (1-9) / daftar ips (comma-separated)
TRUST_PROXY=false

# Rate limiting global per IP (ttl dalam milidetik, limit request per ttl)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- SSO / OAuth2 Authorization Code + PKCE ---
# Base URL server SSO (Laravel Passport) yang menangani login pengguna.
SSO_BASE_URL=http://localhost:8000
# Client ID & secret terdaftar di server SSO (tabel oauth_clients).
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Redirect URI yang didaftarkan (harus SAMA dengan di server SSO).
SSO_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT secret untuk menandatangani token sesi lokal (SSO user → local JWT).
# Setelah login SSO berhasil, aplikasi menyimpan JWT lokal di cookie httpOnly.
# WAJIB ganti di produksi dengan nilai acak yang panjang! Contoh: openssl rand -base64 48
JWT_SECRET=dev-secret-ubah-saya-di-produksi
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=token

# URL browser untuk frontend (Vite dev server). Kosongkan jika same-origin.
FRONTEND_URL=http://localhost:5173

# URL app/API (digunakan untuk CORS & referensi)
APP_URL=http://localhost:3000

# Origin eksternal (subdomain lain) yang boleh mengakses /api, comma-separated.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Versi asset Inertia (ubah saat aset frontend berubah agar browser reload)
INERTIA_VERSION=dev

# Salin file ini ke .env.development / .env.production sesuai kebutuhan,
# lalu isi nilai yang sesuai dengan environment anda.