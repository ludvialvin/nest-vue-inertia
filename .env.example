NODE_ENV=development
PORT=3000

# Percayai X-Forwarded-For/Traffic reverse proxy (untuk rate limit IP asli).
# false / true / jumlah hop (1-9) / daftar ips (comma-separated)
TRUST_PROXY=false

# Rate limiting global per IP (ttl dalam milidetik, limit request per ttl)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# MySQL (database sudah berjalan di localhost).
# Password MySQL default pada contoh ini: mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=mysql
DB_DATABASE=nestjsvue
DB_LOGGING=false

# JWT: WAJIB ganti JWT_SECRET dengan nilai acak yang panjang di produksi!
# Contoh generate: openssl rand -base64 48
JWT_SECRET=dev-secret-ubah-saya-di-produksi
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_MS=604800000
AUTH_COOKIE_NAME=token

# User admin awal (di-seed otomatis jika tabel user kosong)
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# URL browser untuk frontend (Vite dev server). Kosongkan jika same-origin.
FRONTEND_URL=http://localhost:5173

# URL app/API (digunakan untuk CORS & referensi)
APP_URL=http://localhost:3000

# Origin eksternal (subdomain lain) yang boleh mengakses /api, comma-separated.
# Dibiarkan kosong = hanya APP_URL/FRONTEND_URL yang diizinkan.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Versi asset Inertia (ubah saat aset frontend berubah agar browser reload)
INERTIA_VERSION=dev

# Salin file ini ke .env.development / .env.production sesuai kebutuhan,
# lalu isi nilai yang sesuai dengan environment anda.